# Environment Variables for Medivisor India Treatment

# =============================================================================
# NEXT.JS CONFIGURATION
# =============================================================================
NODE_ENV=development

# Site URL - used for sitemap, robots, and absolute URLs
NEXT_PUBLIC_SITE_URL=https://medivisorindiatreatment.com

# =============================================================================
# WIX (CMS & AUTHENTICATION)
# =============================================================================
# Wix Client ID for authentication (public, can be exposed to browser)
NEXT_PUBLIC_WIX_CLIENT_ID=your_wix_client_id_here

# Alternative env variable name (legacy support)
WIX_CLIENT_ID=your_wix_client_id_here

# Wix Contact Collection IDs (for form submissions) - server-side only
WIX_CONTACT_COLLECTION_ID=pacificpatientform

# =============================================================================
# EMAIL & NOTIFICATIONS
# =============================================================================
# Resend API Key (for transactional emails)
#
# The sender address always uses EMAIL_FROM (or the default verified domain).
# The domain must be verified in the Resend dashboard: https://resend.com/domains
#
# TEST MODE (for local development):
#   - Use a key starting with "re_test_"
#   - Emails only go to your Resend account email
#
# PRODUCTION MODE:
#   - Use a key starting with "re_"
#   - Set EMAIL_FROM to a verified domain address (e.g. contact@yourdomain.com)
#
RESEND_API_KEY=re_your_resend_api_key_here

# Email addresses
EMAIL_TO=info@medivisorhealth.com
EMAIL_FROM=Medivisor India Treatment <noreply@noreply.medivisorhealth.com>

# =============================================================================
# YOUTUBE / TESTIMONIALS
# =============================================================================
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=UCXGDsVXUX2ixe6NyvijGYaw

# =============================================================================
# GOOGLE CLOUD TRANSLATION API (server-side only)
# =============================================================================
# This is used by /api/translate for client language switching.
# IMPORTANT: Do NOT use an OAuth Client ID here.
#
# Option 1: API Key (simplest)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create credentials -> API key
# 3. Restrict the key to "Cloud Translation API" (Application restrictions: none,
#    API restrictions: restrict to Cloud Translation API)
# 4. Paste the key below. Valid REST API keys start with "AIza".
#
# GOOGLE_TRANSLATE_API_KEY=AIzaSy...
#
# Option 2: Service Account Key (more secure, for server-side use)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create credentials -> Service Account
# 3. Grant the service account the "Cloud Translation User" role
# 4. Create a JSON key file and download it
# 5. Set the path to the key file below
#
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
#
# Optional: set your project ID (not client ID) for debugging/logging.
# Find it in Google Cloud Console -> Project Settings -> Project ID
# GOOGLE_CLOUD_PROJECT_ID=my-project-id

# =============================================================================
# DEPLOYMENT DETECTION
# =============================================================================
# These are automatically set by Vercel, but included for completeness
# VERCEL=true (auto-set by Vercel)
# VERCEL_URL=your-app.vercel.app (auto-set by Vercel)
# AWS_LAMBDA_FUNCTION_NAME (auto-set by AWS Lambda)
